@model ChessGameD.Web.Models.ReviewViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "复盘";
    // 必须用 Web 默认值(驼峰):前端读的是 move.fen / move.san,默认的 PascalCase 会让它们全是 undefined
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var payload = new
    {
        gameId = Model.GameId,
        white = Model.White,
        black = Model.Black,
        result = Model.Result,
        engineInstalled = Model.EngineInstalled,
        engineVersion = Model.EngineVersion,
        moves = Model.Moves.Select(m => new { m.Ply, m.San, m.Uci, m.Fen, m.Comment }).ToList(),
    };
}

<div class="panel" style="padding: 12px 16px;">
    <div class="game-header">
        <span class="players">@Model.White <span class="muted">vs</span> @Model.Black</span>
        <span class="badge">@Model.Result</span>
        @if (!string.IsNullOrWhiteSpace(Model.Opening))
        {
            <span class="badge">@(Model.Eco != null ? Model.Eco + " · " : "")@Model.Opening</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Date))
        {
            <span class="small muted">@Model.Date</span>
        }
        @if (Model.WhiteElo.HasValue || Model.BlackElo.HasValue)
        {
            <span class="small muted">@(Model.WhiteElo?.ToString() ?? "-") / @(Model.BlackElo?.ToString() ?? "-")</span>
        }
        <span class="spacer" style="flex:1"></span>
        <span class="small muted" id="engine-hint"></span>
    </div>
</div>

<div class="review-layout">
    <div class="review-board">
        <div id="board"></div>

        <div class="nav-bar">
            <button id="btn-first" title="回到开局 (Home)">⏮</button>
            <button id="btn-prev" title="上一步 (←)">◀</button>
            <span class="ply-label" id="ply-label">开局</span>
            <button id="btn-next" title="下一步 (→)">▶</button>
            <button id="btn-last" title="到最后 (End)">⏭</button>
            <button id="btn-flip" title="翻转棋盘 (F)">翻转</button>
            <button id="btn-pv-back" title="结束主变演示,回到棋局当前局面" style="display:none;">返回原局面</button>
        </div>

        <div class="small muted" id="pv-status" style="min-height:18px; margin-top:6px;"></div>

        <div class="eval-bar-wrap">
            <div class="eval-bar">
                <div class="white" id="eval-white" style="width:50%"></div>
                <div class="mid"></div>
                <div class="label" id="eval-label">—</div>
            </div>
        </div>
        <div class="small muted" id="eval-detail">尚未分析当前局面。</div>
    </div>

    <div class="review-side">
        <div class="panel">
            <h2>引擎分析</h2>
            <div class="row" style="gap:8px; margin-bottom:12px;">
                <button class="primary" id="btn-analyze">分析本局</button>
                <button id="btn-analyze-force" title="忽略缓存,全部重算">重新分析</button>
                <button id="btn-stop" disabled>停止</button>
            </div>
            <div class="progress" id="analysis-progress" style="display:none;"><div id="analysis-bar" style="width:0%"></div></div>
            <div class="small muted" id="analysis-status" style="margin-top:6px;"></div>
            <div class="kv" style="margin-top:10px;">
                <div class="k">引擎推荐</div><div class="mono" id="stored-rec">—</div>
            </div>
            <div id="instant-panel" style="margin-top:12px;">
                <div class="kv">
                    <div class="k">当前分值</div><div class="mono" id="inst-score">—</div>
                    <div class="k">深度</div><div class="mono" id="inst-depth">—</div>
                    <div class="k">节点</div><div class="mono" id="inst-nodes">—</div>
                </div>
                <h3>主变 (PV)</h3>
                <div class="pv-line" id="inst-pv">—</div>
                <div class="small muted">点击主变里的着法,棋盘会从当前局面逐步演示到那一步。</div>
                <h3>候选</h3>
                <div class="candidate-list" id="inst-candidates"></div>
            </div>
        </div>

        <div class="panel">
            <h2>走法</h2>
            <div class="movelist" id="movelist"></div>
        </div>

        <div class="panel">
            <h2>评估曲线</h2>
            <canvas id="evalchart" width="800" height="300"></canvas>
            <div class="small muted">横轴为步数,纵轴为相对白方的评估。点击曲线可跳转到对应局面。</div>
        </div>

        <div class="panel">
            <h2>PGN 与导出</h2>
            <div class="row" style="gap:8px; margin-bottom:10px; flex-wrap:wrap;">
                <a class="btn" id="btn-report-html" href="#" target="_blank" rel="noopener">导出 HTML 报告</a>
                <button id="btn-report-text">导出文本报告</button>
            </div>
            <div class="pgn-text" id="pgn-text">@Model.PgnText</div>
        </div>
    </div>
</div>

<script id="game-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(payload, jsonOptions))</script>

@section Scripts {
    <script type="module" src="~/js/review.js"></script>
}
