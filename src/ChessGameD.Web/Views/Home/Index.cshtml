@model HomeViewModel
@{
    ViewData["Title"] = "首页";
}

<div class="row wrap">
    <div class="col" style="max-width: 620px;">
        <div class="panel">
            <h2>引擎状态</h2>
            <div class="kv">
                <div class="k">状态</div>
                <div><span id="engine-state" class="badge">加载中…</span></div>
                <div class="k">版本</div>
                <div id="engine-version" class="mono">—</div>
                @if (Model.IsAdmin)
                {
                    @* 引擎路径属于服务器内部信息,只有管理员看得到 *@
                    <div class="k">路径</div>
                    <div id="engine-path" class="mono small">—</div>
                }
                <div class="k">运行平台</div>
                <div id="engine-platform" class="mono small">—</div>
            </div>
            <div id="platform-warning" class="small" style="color:#e88; margin-top:10px; display:none;">
                已安装的引擎与当前运行平台不一致,请到设置页重新下载对应平台的引擎。
            </div>
            <div style="margin-top: 14px;">
                @if (Model.IsAdmin)
                {
                    <a class="btn" href="/Settings/Index">前往设置页安装 / 调整引擎</a>
                }
                else
                {
                    @* 引擎是全局的,只有管理员能装;普通用户看到引导文案就行 *@
                    <span class="small muted">引擎由管理员统一安装与管理,还没装好时请联系管理员。</span>
                }
            </div>
        </div>

        <div class="panel">
            <h2>导入 PGN</h2>
            <form id="import-form">
                <label class="field">
                    <span>选择 PGN 文件(可以包含多局)</span>
                    <input type="file" id="import-file" accept=".pgn,.txt" />
                </label>
                <label class="field">
                    <span>或者直接粘贴 PGN 文本</span>
                    <textarea id="import-text" placeholder='[Event "?"] ...'></textarea>
                </label>
                <div class="row" style="align-items: center;">
                    <button class="primary" type="submit" id="import-btn">开始导入</button>
                    <span id="import-status" class="small muted"></span>
                </div>
            </form>
            <div id="import-result"></div>
        </div>
    </div>

    <div class="col">
        <div class="panel">
            <h2>最近的棋局 <span class="badge">@Model.TotalGames</span></h2>
            @if (Model.RecentGames.Count == 0)
            {
                <p class="muted">还没有导入任何棋局。先在左侧导入一个 PGN 文件吧。</p>
            }
            else
            {
                <table class="games">
                    <thead>
                        <tr>
                            <th>白方</th>
                            <th>黑方</th>
                            <th>结果</th>
                            <th>日期</th>
                            <th>开局</th>
                            <th>分析</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.RecentGames)
                        {
                            <tr>
                                <td><a href="/Games/Review/@g.Id">@g.White</a></td>
                                <td>@g.Black</td>
                                <td class="result">@g.Result</td>
                                <td class="small muted">@(g.Date ?? "-")</td>
                                <td class="small">@(g.Opening ?? g.Eco ?? "-")</td>
                                <td>@Html.Raw(g.HasAnalysis ? "<span class=\"badge ok\">已分析</span>" : "<span class=\"badge\">未分析</span>")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p style="margin-top:12px"><a href="/Games/Index">查看全部棋局 →</a></p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home.js"></script>
}
